# Local learner identity for this prototype only (not authentication)
DEMO_LEARNER_ID=d847c7fe-2d42-49d4-8e4d-dde0acbbfd6a

# Local MongoDB via docker-compose
MONGODB_URI=mongodb://localhost:27017/designloop

# Copy your own key from https://aistudio.google.com/apikey
# Keep this secret on the backend. Never put it in the Vite frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Frontend development origins. Do not use wildcard origins in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
UPLOADS_DIR=./data/uploads
MAX_FILE_SIZE=20MB
DESIGNLOOP_MAX_FILE_SIZE_BYTES=20971520
MAX_ATTACHMENTS_PER_ATTEMPT=8
MAX_EVALUATION_RUNS=3
